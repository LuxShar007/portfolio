{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/src/index.html" },
    { "source": "/about", "destination": "/src/about.html" },
    { "source": "/expertise", "destination": "/src/expertise.html" },
    { "source": "/milestones", "destination": "/src/milestones.html" },
    { "source": "/projects", "destination": "/src/projects.html" },
    { "source": "/connect", "destination": "/src/connect.html" },
    { "source": "/favicon.ico", "destination": "/src/favicon.ico" },
    { "source": "/favicon.svg", "destination": "/src/favicon.svg" },
    { "source": "/:font(SF-Pro-[^/]+\\.otf)", "destination": "/assets/FONT/:font" },
    { "source": "/assets/:font(SF-Pro-[^/]+\\.otf)", "destination": "/assets/FONT/:font" },
    { "source": "/assets/media/video/Website 2.mp4", "destination": "/assets/media/video/Website_2.mp4" },
    { "source": "/assets/media/video/Website 3.mp4", "destination": "/assets/media/video/Website_3.mp4" },
    { "source": "/assets/:match*", "destination": "/assets/:match*" },
    { "source": "/media/:match*", "destination": "/assets/media/:match*" },
    { "source": "/:filename([^/]+\\.(?:js|css|map|ico|svg|otf))", "destination": "/src/:filename" },
    { "source": "/:filename([^/]+\\.html)", "destination": "/src/:filename" }
  ],
  "headers": [
    {
      "source": "/assets/media/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    },
    {
      "source": "/assets/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/FONT/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
